+        //   eye = −alt·new_forward = (sb·sp, −cp, cb·sp)·alt  — wait, that's wrong.
+        //
+        // Correct derivation (rotate camera around right axis by +pitch):
+        //   forward_original = (0, 1, 0)
+        //   right = (cb, 0, −sb)
+        //   right × forward = (sb, 0, cb)   [note: this is the up direction]
+        //   forward' = forward·cos(pitch) + (right × forward)·sin(pitch)
+        //            = (sb·sp, cp, cb·sp)
+        //   eye = −alt · forward' = (−sb·sp·alt, −cp·alt, −cb·sp·alt)
+        //   up  = up_original·cos(pitch) + (right × up_original)·sin(pitch)
+        //       = (sb, 0, cb)·cos(pitch) + (right × (sb,0,cb))·sin(pitch)
+        //   right × (sb,0,cb) = (cb,0,−sb)×(sb,0,cb) = (0·cb−(−sb)·0, (−sb)·sb−cb·cb, cb·0−0·sb)
