+        // Calculate view matrix.
+        // Bearing rotates the camera around the globe's Y axis (vertical at centre).
+        // Pitch tilts the camera backward along the bearing's right axis:
+        //   right = (cb, 0, −sb), so rotating forward by pitch gives:
+        //   new_forward = (−sb·sp, cp, −cb·sp)
+        //   eye = −alt·new_forward = (sb·sp, −cp, cb·sp)·alt  — wait, that’s wrong.
+        //
+        // Correct derivation (rotate camera around right axis by +pitch):
+        //   forward_original = (0, 1, 0)
+        //   right = (cb, 0, −sb)
+        //   right × forward = (sb, 0, cb)   [note: this is the up direction]
+        //   forward' = forward·cos(pitch) + (right × forward)·sin(pitch)
+        //            = (sb·sp, cp, cb·sp)
+        //   eye = −alt · forward' = (−sb·sp·alt, −cp·alt, −cb·sp·alt)
+        //   up  = up_original·cos(pitch) + (right × up_original)·sin(pitch)
+        //       = (sb, 0, cb)·cos(pitch) + (right × (sb,0,cb))·sin(pitch)
+        //   right × (sb,0,cb) = (cb,0,−sb)×(sb,0,cb) = (0·cb−(−sb)·0, (−sb)·sb−cb·cb, cb·0−0·sb)
+        //                     = (0, −1, 0)
+        //   up = (sb·cp, −sp, cb·cp)
+        //
+        // At pitch=0: eye=(0,−alt,0), up=(sb,0,cb). At bearing=pitch=0: matches original defaults.
+        const bearingRad = bearing * DEGREES_TO_RADIANS;
+        const pitchRad   = pitch   * DEGREES_TO_RADIANS;
+        const sb = Math.sin(bearingRad), cb = Math.cos(bearingRad);
+        const sp = Math.sin(pitchRad),   cp = Math.cos(pitchRad);
+        const viewMatrix = new Matrix4().lookAt({
+            eye: [-sb * sp * altitude, -cp * altitude, -cb * sp * altitude],
+            up:  [sb * cp, -sp, cb * cp],
+        });
         viewMatrix.rotateX(latitude * DEGREES_TO_RADIANS);
         viewMatrix.rotateZ(-longitude * DEGREES_TO_RADIANS);
         viewMatrix.scale(scale / height);
